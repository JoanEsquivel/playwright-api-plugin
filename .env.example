# ---- API under test ----
# Include the path prefix; a trailing slash is added automatically.
API_BASE_URL=http://localhost:8000/api/

# Seeded accounts. Tests treat them as READ-ONLY; anything that mutates per-user
# state registers its own user (see the newUserApi fixture).
API_USER_EMAIL=
API_USER_PASSWORD=
API_ADMIN_EMAIL=
API_ADMIN_PASSWORD=

# ---- Optional: let Playwright start the API (webServer) ----
# Leave unset when the API is already running or hosted elsewhere.
# API_SERVER_COMMAND=uv run uvicorn app.main:app --port 8000 --log-level warning
# API_SERVER_CWD=../the-test-automation-website/backend
# API_SERVER_READY_URL=http://localhost:8000/api/health

# ---- Optional ----
# WORKERS=1                          # force serial execution locally
