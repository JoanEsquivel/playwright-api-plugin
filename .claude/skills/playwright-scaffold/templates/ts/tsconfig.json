{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "eslint.config.mjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "test-results", "playwright-report", "blob-report", ".claude"]
}
